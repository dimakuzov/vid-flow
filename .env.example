# Copy to .env.local in the project root and fill in what you need. Never commit .env.local.
# Everything is optional except the key for the service you use. See README.md for the full table.

# Comfy Cloud (only needed if you send jobs to the cloud)
COMFY_CLOUD_API_KEY=

# ElevenLabs voices (only needed for speech in the post stage)
ELEVENLABS_API_KEY=

# ComfyUI transport: legacy (direct HTTP to COMFY_URL) or sdk (official @comfyorg/sdk, needs comfy-api-proxy)
# COMFY_TRANSPORT=legacy
# COMFY_URL=http://127.0.0.1:8188
# COMFY_BASE_URL=http://127.0.0.1:8189

# Who runs "Send to agent": manual, ollama or claude
# FRAMEBOARD_AGENT_PROVIDER=manual
# FRAMEBOARD_OLLAMA_URL=http://127.0.0.1:11434
# FRAMEBOARD_OLLAMA_MODEL=

# Data folder (default: data/)
# DATA_ROOT=
