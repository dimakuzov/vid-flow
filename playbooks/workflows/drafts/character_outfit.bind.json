{
  "format": "frameboard.graph-binding/1",
  "id": "character_outfit",
  "graph": "character_outfit_qwen21.json",
  "stage": "characters",
  "label": "Character: shot outfit",
  "description": "Qwen Image 2.1 outfit edit of a library character, from an outfit reference in refs/ or from text. One run per character.",
  "playbook": "models/qwen_image.en.md",
  "order": 10,
  "aliases": [],
  "forEach": "character",
  "inputs": {
    "base": {
      "kind": "image",
      "from": "library:character",
      "pick": "first",
      "uploadAs": "{shotId}_{character}_base{ext}",
      "label": "База персонажа (data/characters/{character}/full_body.png)"
    },
    "clothes": {
      "kind": "image",
      "from": "refs",
      "match": "{character}_clothes*",
      "pick": "newest",
      "min": 0,
      "uploadAs": "{shotId}_{character}_clothes{ext}",
      "label": "Референс одежды в refs/ ({character}_clothes.png), необязательно"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "section": "{character}",
      "required": true,
      "label": "prompt.md (раздел ## {character})"
    }
  },
  "slots": [
    {
      "targets": [{ "node": "10", "field": "image" }],
      "value": { "input": "base" }
    },
    {
      "targets": [{ "node": "22", "field": "image" }],
      "value": { "input": "clothes" },
      "whenEmpty": {
        "remove": [{ "node": "22" }, { "node": "17", "field": "images.image_2" }]
      }
    },
    {
      "targets": [{ "node": "16", "field": "value" }],
      "value": { "input": "text" }
    },
    {
      "targets": [{ "node": "19", "field": "seed" }],
      "value": { "seed": "random" }
    },
    {
      "targets": [{ "node": "21", "field": "filename_prefix" }],
      "value": { "template": "frameboard/characters/{shotId}_{character}_outfit" }
    }
  ]
}
