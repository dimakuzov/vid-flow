{
  "format": "frameboard.graph-binding/1",
  "id": "location_views",
  "graph": "location_views_multiple_angles.json",
  "stage": "location",
  "label": "Локация: 4 ракурса по общему виду",
  "description": "Общий вид локации без людей: четыре ветки ракурса, у каждой свой раздел prompt.md.",
  "playbook": "models/qwen_location.en.md",
  "order": 10,
  "inputs": {
    "view": {
      "kind": "image",
      "from": [
        "refs",
        "library:location"
      ],
      "pick": "first",
      "label": "Общий вид локации (refs/ или data/locations/)"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "sections": [
        "simple",
        "objects",
        "camera",
        "camera_objects"
      ],
      "untitled": "all",
      "label": "prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "25",
          "field": "image"
        }
      ],
      "value": {
        "input": "view"
      }
    },
    {
      "targets": [
        {
          "node": "100",
          "field": "value"
        }
      ],
      "value": {
        "input": "text",
        "section": "simple"
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "104"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "110",
          "field": "value"
        }
      ],
      "value": {
        "input": "text",
        "section": "objects"
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "114"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "120",
          "field": "value"
        }
      ],
      "value": {
        "input": "text",
        "section": "camera"
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "124"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "130",
          "field": "value"
        }
      ],
      "value": {
        "input": "text",
        "section": "camera_objects"
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "134"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "102",
          "field": "seed"
        },
        {
          "node": "112",
          "field": "seed"
        },
        {
          "node": "122",
          "field": "seed"
        },
        {
          "node": "132",
          "field": "seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "104",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/location/{shotId}_v1_simple"
      }
    },
    {
      "targets": [
        {
          "node": "114",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/location/{shotId}_v2_objects"
      }
    },
    {
      "targets": [
        {
          "node": "124",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/location/{shotId}_v3_camera"
      }
    },
    {
      "targets": [
        {
          "node": "134",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/location/{shotId}_v4_camera_objects"
      }
    }
  ]
}
