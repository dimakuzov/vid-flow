      },
      "whenEmpty": {
        "remove": [
          {
            "node": "305"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_5"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "306",
          "field": "image"
        }
      ],
      "value": {
