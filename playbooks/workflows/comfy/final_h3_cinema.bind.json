      },
      "whenEmpty": {
        "remove": [
          {
            "node": "302"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_2"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "303",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people"
        ],
        "index": 2
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "303"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_3"
          }
        ]
