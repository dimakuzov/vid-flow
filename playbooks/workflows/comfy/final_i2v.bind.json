{
  "format": "frameboard.graph-binding/1",
  "id": "final_i2v",
  "graph": "wan22_i2v_sketch_turbo_api.json",
  "stage": "final_render",
  "label": "Final from the first frame (i2v)",
  "description": "For now the final equals the preview: the same graph and settings, files in frameboard/final/. See stages/final_render.en.md.",
  "playbook": "models/wan_video.en.md",
  "order": 10,
  "aliases": [
    "i2v"
  ],
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Approved first frame"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "prompt:seconds",
      "min": 2,
      "max": 12,
      "label": "Duration in prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/final/{shotId}_i2v"
      }
    }
  ]
}
