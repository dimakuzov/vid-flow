{
  "format": "frameboard.graph-binding/1",
  "id": "video_i2v",
  "graph": "wan22_i2v_sketch_turbo_api.json",
  "stage": "video_preview",
  "label": "Видео от первого кадра (i2v)",
  "description": "Движение от утверждённого первого кадра. По умолчанию.",
  "playbook": "models/wan_video.en.md",
  "order": 10,
  "aliases": [
    "i2v"
  ],
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "settings:seconds",
      "fallback": "prompt:seconds",
      "min": 2,
      "max": 12,
      "label": "Длительность клипа"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/video/{shotId}_i2v"
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "width"
        }
      ],
      "value": {
        "const": 576
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "height"
        }
      ],
      "value": {
        "const": 1024
      }
    }
  ]
}
