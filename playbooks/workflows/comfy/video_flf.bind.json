{
  "format": "frameboard.graph-binding/1",
  "id": "video_flf",
  "graph": "wan22_flf_sketch_turbo_api.json",
  "stage": "video_preview",
  "label": "Video between the first and last frame (FLF)",
  "description": "For a specific end pose or a change of state: put the last frame in refs/.",
  "playbook": "models/wan_video.en.md",
  "order": 20,
  "aliases": [
    "flf"
  ],
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Approved first frame"
    },
    "end": {
      "kind": "image",
      "from": "refs",
      "pick": "newest",
      "uploadAs": "{shotId}_end{ext}",
      "label": "Last frame in refs/"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "settings:seconds",
      "fallback": "prompt:seconds",
      "min": 2,
      "max": 12,
      "label": "Clip duration"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "98",
          "field": "image"
        }
      ],
      "value": {
        "input": "end"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/video/{shotId}_flf"
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "width"
        }
      ],
      "value": {
        "const": 576
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "height"
        }
      ],
      "value": {
        "const": 1024
      }
    }
  ]
}
