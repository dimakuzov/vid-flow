{
  "format": "frameboard.graph-binding/1",
  "id": "video_minimax",
  "graph": "minimax_h3_preview_api.json",
  "stage": "video_preview",
  "label": "Video MiniMax H3 Cinema: first frame + faces",
  "description": "MiniMax H3 from references, one pass at 0.5 MP: the first frame and each character's face, with sound and speech. \"▶ Every shot\" runs it second, after LTX.",
  "playbook": "models/minimax_h3.en.md",
  "imageLabel": "<Picture {n}>",
  "order": 6,
  "inputs": {
    "first": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "lock": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "min": 0,
      "whenShot": "strictFirstFrame",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Строго первый кадр: утверждённый первый кадр закреплён на кадре 0 видео (галка «Строго первый кадр» кадра)"
    },
    "people": {
      "kind": "image",
      "from": [
        "library:faces-or-characters"
      ],
      "pick": "all",
      "min": 0,
      "max": 6,
      "uploadAs": "{shotId}_preview_ref{index}{ext}",
      "label": "Лица персонажей: лист лица, иначе лицо, иначе утверждённый персонаж (refs/{имя}_face_sheet или {имя}_face — свои на кадр)"
    },
    "extras": {
      "kind": "image",
      "from": [
        "refs:other",
        "refs:other:first_frame"
      ],
      "pick": "all",
      "min": 0,
      "max": 6,
      "uploadAs": "{shotId}_preview_extra{index}{ext}",
      "label": "Референсы пользователя (машина, вещь, деталь места): refs/ этого этапа, иначе refs/ первого кадра. Идут после лиц, всего 6 картинок"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "settings:seconds",
      "fallback": "prompt:seconds",
      "min": 2,
      "max": 10,
      "label": "Длительность клипа"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "28",
          "field": "image"
        }
      ],
      "value": {
        "input": "first"
      }
    },
    {
      "targets": [
        {
          "node": "29",
          "field": "image"
        }
      ],
      "value": {
        "input": "lock"
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "29"
          },
          {
            "node": "400"
          },
          {
            "node": "145",
            "field": "conditioning",
            "relink": [
              "121",
              0
            ]
          },
          {
            "node": "146",
            "field": "conditioning",
            "relink": [
              "121",
              0
            ]
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "301",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 0
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "301"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_1"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "302",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 1
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "302"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_2"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "303",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 2
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "303"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_3"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "304",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 3
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "304"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_4"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "305",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 4
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "305"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_5"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "306",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "extras"
        ],
        "index": 5
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "306"
          },
          {
            "node": "121",
            "field": "ref_images.ref_image_6"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "190",
          "field": "value"
        }
      ],
      "value": {
        "input": "text",
        "steps": [
          {
            "ensure": "subject_definitions ASTROCINEMAV01K2T:",
            "at": "start",
            "unless": "ASTROCINEMAV01K2T",
            "separator": "\n"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "155",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "111",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "192",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/video/{shotId}_h3"
      }
    }
  ]
}
