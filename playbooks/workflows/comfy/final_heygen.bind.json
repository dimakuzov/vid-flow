{
  "format": "frameboard.graph-binding/1",
  "id": "final_heygen",
  "graph": "heygen_video_i2v_api.json",
  "stage": "final_render",
  "label": "Финал HeyGen 1.0 (Comfy Cloud, платно)",
  "description": "Диалог двух персонажей с движением губ: HeyGen Image to Video в Comfy Cloud от утверждённого первого кадра. Платно: ~45.3 кредита за 10 с, 5–15 с. По умолчанию для кадров, где говорят двое и больше.",
  "playbook": "models/heygen_video.en.md",
  "order": 2,
  "defaultWhen": "dialogue",
  "target": "cloud",
  "cost": {
    "credits": 45.3,
    "perSeconds": 10
  },
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_heygen_first{ext}",
      "label": "Утверждённый первый кадр"
    },
    "preview": {
      "kind": "video",
      "from": "approve:video_preview",
      "pick": "newest",
      "min": 0,
      "label": "Утверждённое превью (только длительность)"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "requireSpeech": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "media:duration",
      "of": "preview",
      "min": 5,
      "max": 15,
      "clamp": true,
      "label": "Длительность превью (5–15 с)"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "5",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "9",
          "field": "model.prompt"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "9",
          "field": "model.duration"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "9",
          "field": "model.seed"
        }
      ],
      "value": {
        "seed": "random",
        "max": 4294967295
      }
    },
    {
      "targets": [
        {
          "node": "3",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/final/{shotId}_heygen"
      }
    }
  ]
}
