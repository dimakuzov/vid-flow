{
  "format": "frameboard.graph-binding/1",
  "id": "video_ltx",
  "graph": "ltx25_i2v_api.json",
  "stage": "video_preview",
  "label": "Video LTX 2.5 from the first frame (i2v)",
  "description": "LTX 2.5, 24 fps, with sound: characters can speak the lines from the shot's Lines. Default on a preview; \"▶ Every shot\" runs it first, then MiniMax.",
  "playbook": "models/ltx_video.en.md",
  "order": 5,
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "settings:seconds",
      "fallback": "prompt:seconds",
      "min": 2,
      "max": 10,
      "label": "Длительность клипа"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "395",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "398:376",
          "field": "value"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "398:339",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "398:362",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "75",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/video/{shotId}_ltx"
      }
    }
  ]
}
