{
  "format": "frameboard.graph-binding/1",
  "id": "first_frame_compositing",
  "graph": "qwen21_character_compositing.json",
  "stage": "first_frame",
  "label": "Первый кадр: персонажи в локации",
  "description": "Вписать утверждённых персонажей (1–2) в утверждённую локацию. Для крупного плана агент добавляет лица фразой «face from image N».",
  "playbook": "models/qwen_first_frame.en.md",
  "order": 10,
  "inputs": {
    "location": {
      "kind": "image",
      "from": "approve:location",
      "pick": "newest",
      "label": "Утверждённая локация"
    },
    "people": {
      "kind": "image",
      "from": "approve:characters",
      "pick": "all",
      "min": 1,
      "max": 2,
      "label": "Утверждённые персонажи"
    },
    "faces": {
      "kind": "image",
      "from": "library:faces",
      "pick": "all",
      "min": 0,
      "max": 2,
      "whenPrompt": "\\bface from image \\d+\\b",
      "uploadAs": "{shotId}_face{index}{ext}",
      "label": "Лица персонажей (только если в промпте есть «face from image N»)"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "470",
          "field": "image"
        }
      ],
      "value": {
        "input": "location"
      }
    },
    {
      "targets": [
        {
          "node": "902",
          "field": "image"
        }
      ],
      "value": {
        "input": "people",
        "index": 0
      }
    },
    {
      "targets": [
        {
          "node": "903",
          "field": "image"
        }
      ],
      "value": {
        "input": "people",
        "index": 1
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "903"
          },
          {
            "node": "488",
            "field": "images.image_3"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "904",
          "field": "image"
        }
      ],
      "value": {
        "input": "faces",
        "index": 0
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "904"
          },
          {
            "node": "488",
            "field": "images.image_4"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "905",
          "field": "image"
        }
      ],
      "value": {
        "input": "faces",
        "index": 1
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "905"
          },
          {
            "node": "488",
            "field": "images.image_5"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "477",
          "field": "value"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "485",
          "field": "seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "461",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/first_frame/{shotId}_ff"
      }
    }
  ]
}
