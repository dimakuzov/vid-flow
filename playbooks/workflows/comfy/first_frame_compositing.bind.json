{
  "format": "frameboard.graph-binding/1",
  "id": "first_frame_compositing",
  "graph": "qwen21_character_compositing.json",
  "stage": "first_frame",
  "label": "Первый кадр: персонажи в локации",
  "description": "Вписать утверждённых персонажей в утверждённую локацию. Если в кадре нет персонажей, в граф идёт только локация, а промпт добавляет лишь то, что написано. Иначе в граф уходят локация (image 1), персонажи и их портреты — до 6 картинок.",
  "playbook": "models/qwen_first_frame.en.md",
  "order": 10,
  "inputs": {
    "location": {
      "kind": "image",
      "from": "approve:location",
      "pick": "newest",
      "label": "Утверждённая локация"
    },
    "people": {
      "kind": "image",
      "from": "approve:characters",
      "pick": "all",
      "min": 1,
      "max": 5,
      "label": "Утверждённые персонажи"
    },
    "faces": {
      "kind": "image",
      "from": "library:faces",
      "pick": "all",
      "min": 0,
      "max": 5,
      "uploadAs": "{shotId}_face{index}{ext}",
      "label": "Портреты персонажей"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "470",
          "field": "image"
        }
      ],
      "value": {
        "input": "location"
      }
    },
    {
      "targets": [
        {
          "node": "902",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces"
        ],
        "index": 0
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "902"
          },
          {
            "node": "488",
            "field": "images.image_2"
          }
        ]
      }
    },
    {
