{
  "format": "frameboard.graph-binding/1",
  "id": "first_frame_compositing",
  "graph": "qwen21_character_compositing.json",
  "stage": "first_frame",
  "label": "First frame: characters in the location",
  "description": "Places the approved characters into the approved location. If the shot has no characters, only the location goes into the graph and the prompt adds only what is written. Otherwise the graph receives the location (image 1), the characters, then the faces of those close to the camera, then the user's references from refs/, then the faces of those far away: up to 6 pictures.",
  "playbook": "models/qwen_first_frame.en.md",
  "order": 10,
  "inputs": {
    "location": {
      "kind": "image",
      "from": "approve:location",
      "pick": "newest",
      "label": "Approved location"
    },
    "people": {
      "kind": "image",
      "from": "approve:characters",
      "pick": "all",
      "min": 1,
      "max": 5,
      "label": "Approved characters"
    },
    "faces": {
      "kind": "image",
      "from": "library:faces",
      "pick": "all",
      "min": 0,
      "max": 5,
      "uploadAs": "{shotId}_face{index}{ext}",
      "label": "Portraits of characters close to the camera",
      "framing": "near"
    },
    "extras": {
      "kind": "image",
      "from": "refs:other",
      "pick": "all",
      "min": 0,
      "max": 5,
      "uploadAs": "{shotId}_ref{index}{ext}",
      "label": "User references"
    },
    "faces_far": {
      "kind": "image",
      "from": "library:faces",
      "framing": "far",
      "pick": "all",
      "min": 0,
      "max": 5,
      "uploadAs": "{shotId}_farface{index}{ext}",
      "label": "Portraits of characters far from the camera"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "470",
          "field": "image"
        }
      ],
      "value": {
        "input": "location"
      }
    },
    {
      "targets": [
        {
          "node": "902",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces",
          "extras",
          "faces_far"
        ],
        "index": 0
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "902"
          },
          {
            "node": "488",
            "field": "images.image_2"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "903",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces",
          "extras",
          "faces_far"
        ],
        "index": 1
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "903"
          },
          {
            "node": "488",
            "field": "images.image_3"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "904",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces",
          "extras",
          "faces_far"
        ],
        "index": 2
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "904"
          },
          {
            "node": "488",
            "field": "images.image_4"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "905",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces",
          "extras",
          "faces_far"
        ],
        "index": 3
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "905"
          },
          {
            "node": "488",
            "field": "images.image_5"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "906",
          "field": "image"
        }
      ],
      "value": {
        "inputs": [
          "people",
          "faces",
          "extras",
          "faces_far"
        ],
        "index": 4
      },
      "whenEmpty": {
        "remove": [
          {
            "node": "906"
          },
          {
            "node": "488",
            "field": "images.image_6"
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "477",
          "field": "value"
        }
      ],
      "value": {
        "input": "text"
      }
    },
    {
      "targets": [
        {
          "node": "485",
          "field": "seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "461",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/first_frame/{shotId}_ff"
      }
    }
  ]
}
