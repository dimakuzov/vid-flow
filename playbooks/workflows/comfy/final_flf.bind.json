{
  "format": "frameboard.graph-binding/1",
  "id": "final_flf",
  "graph": "wan22_flf_sketch_turbo_api.json",
  "stage": "final_render",
  "label": "Финал между кадрами (FLF, как превью)",
  "description": "Пока тот же граф, что и превью. Решение по финалу — бриф 4.",
  "playbook": "models/wan_video.md",
  "order": 20,
  "aliases": [
    "flf"
  ],
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "end": {
      "kind": "image",
      "from": "refs",
      "pick": "newest",
      "uploadAs": "{shotId}_end{ext}",
      "label": "Последний кадр в refs/"
    },
    "text": {
      "kind": "text",
      "from": "prompt",
      "required": true,
      "label": "prompt.md"
    },
    "seconds": {
      "kind": "number",
      "from": "prompt:seconds",
      "min": 2,
      "max": 8,
      "label": "Длительность в prompt.md"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "98",
          "field": "image"
        }
      ],
      "value": {
        "input": "end"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text",
        "steps": [
          {
            "namesTo": "the person"
          },
          {
            "ensure": "Static shot, fixed camera.",
            "at": "start",
            "unless": "\b(camera|shot|static|pan|dolly|zoom|трек|камер)\b",
            "separator": " "
          },
          {
            "ensure": "Realistic, natural movement.",
            "at": "end",
            "unless": "realistic, natural movement",
            "separator": " "
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/final/{shotId}_flf"
      }
    }
  ]
}
