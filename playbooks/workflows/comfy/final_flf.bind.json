{
  "format": "frameboard.graph-binding/1",
  "id": "final_flf",
  "graph": "wan22_flf_sketch_turbo_api.json",
  "stage": "final_render",
  "label": "Final Wan between frames (FLF), 720×1280",
  "description": "The same prompt, first frame and last frame as the approved FLF preview, at 720×1280 and 24 fps. Default when the approved preview is FLF.",
  "playbook": "models/wan_video.en.md",
  "order": 8,
  "aliases": [
    "flf"
  ],
  "whenSketch": {
    "of": "preview",
    "nodes": [
      {
        "node": "98",
        "field": "image"
      }
    ],
    "filename": "_flf"
  },
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "end": {
      "kind": "image",
      "from": [
        "refs",
        "refs:video_preview"
      ],
      "pick": "newest",
      "uploadAs": "{shotId}_end{ext}",
      "label": "Последний кадр (refs/ финала, иначе refs/ эскиза)"
    },
    "preview": {
      "kind": "video",
      "from": "approve:video_preview",
      "pick": "newest",
      "min": 0,
      "label": "Утверждённое превью (длительность и промпт)"
    },
    "text": {
      "kind": "text",
      "from": "approve-meta",
      "of": "preview",
      "nodes": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "fallback": "prompt",
      "stage": "video_preview",
      "required": true,
      "label": "Промпт утверждённого эскиза"
    },
    "seconds": {
      "kind": "number",
      "from": "media:duration",
      "of": "preview",
      "min": 2,
      "max": 12,
      "label": "Длительность превью"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "98",
          "field": "image"
        }
      ],
      "value": {
        "input": "end"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text",
        "steps": [
          {
            "ensure": "The background stays exactly as in the first frame for the whole clip: no new people appear, nobody walks or moves in the background, doors, windows and curtains stay as they are, and no new objects appear. Only the movements described above happen.",
            "at": "end",
            "unless": "no new people appear",
            "separator": " "
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/final/{shotId}_flf720"
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "width"
        }
      ],
      "value": {
        "const": 720
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "height"
        }
      ],
      "value": {
        "const": 1280
      }
    },
    {
      "targets": [
        {
          "node": "129:162",
          "field": "value"
        }
      ],
      "value": {
        "const": 24
      }
    }
  ]
}
