{
  "format": "frameboard.graph-binding/1",
  "id": "final_wan_720",
  "graph": "wan22_i2v_sketch_turbo_api.json",
  "stage": "final_render",
  "label": "Финал Wan от первого кадра, 720×1280",
  "description": "Тот же промпт и первый кадр, что у эскиза, в 720×1280. По умолчанию для кадров без реплик.",
  "playbook": "models/wan_video.en.md",
  "order": 3,
  "inputs": {
    "start": {
      "kind": "image",
      "from": "approve:first_frame",
      "pick": "newest",
      "uploadAs": "{shotId}_start{ext}",
      "label": "Утверждённый первый кадр"
    },
    "preview": {
      "kind": "video",
      "from": "approve:video_preview",
      "pick": "newest",
      "min": 0,
      "label": "Утверждённое превью (только длительность)"
    },
    "text": {
      "kind": "text",
      "from": "approve-meta",
      "of": "preview",
      "nodes": [
        { "node": "129:93", "field": "text" },
        { "node": "398:376", "field": "value" }
      ],
      "fallback": "prompt",
      "stage": "video_preview",
      "required": true,
      "label": "Промпт утверждённого эскиза"
    },
    "seconds": {
      "kind": "number",
      "from": "media:duration",
      "of": "preview",
      "min": 2,
      "max": 12,
      "label": "Длительность превью"
    }
  },
  "slots": [
    {
      "targets": [
        {
          "node": "97",
          "field": "image"
        }
      ],
      "value": {
        "input": "start"
      }
    },
    {
      "targets": [
        {
          "node": "129:93",
          "field": "text"
        }
      ],
      "value": {
        "input": "text",
        "steps": [
          {
            "ensure": "The background stays exactly as in the first frame for the whole clip: no new people appear, nobody walks or moves in the background, doors, windows and curtains stay as they are, and no new objects appear. Only the movements described above happen.",
            "at": "end",
            "unless": "no new people appear",
            "separator": " "
          }
        ]
      }
    },
    {
      "targets": [
        {
          "node": "129:86",
          "field": "noise_seed"
        }
      ],
      "value": {
        "seed": "random"
      }
    },
    {
      "targets": [
        {
          "node": "129:161",
          "field": "value"
        }
      ],
      "value": {
        "input": "seconds"
      }
    },
    {
      "targets": [
        {
          "node": "108",
          "field": "filename_prefix"
        }
      ],
      "value": {
        "template": "frameboard/final/{shotId}_wan720"
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "width"
        }
      ],
      "value": {
        "const": 720
      }
    },
    {
      "targets": [
        {
          "node": "129:98",
          "field": "height"
        }
      ],
      "value": {
        "const": 1280
      }
    },
    {
      "targets": [
        {
          "node": "129:162",
          "field": "value"
        }
      ],
      "value": {
        "const": 24
      }
    }
  ],
  "defaultWhen": "silent"
}
